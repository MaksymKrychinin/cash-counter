rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admin account (must match ADMIN_EMAILS in db.js). Create it in the console
    // and keep sign-up disabled so nobody can register this email if it's ever deleted.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@admin.com';
    }

    function isValidEntry(d) {
      return d.keys().hasAll(['name', 'amount', 'currency', 'kind', 'date'])
        && d.keys().hasOnly(['name', 'amount', 'currency', 'kind', 'date', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.amount is number && d.amount > 0 && d.amount < 1000000000
        && d.currency in ['PLN', 'USD', 'EUR', 'UAH', 'USDT']
        && d.kind in ['required', 'optional']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.updatedAt == request.time;
    }

    function isValidProfile(d) {
      return d.keys().hasOnly(['email', 'lastSeen'])
        && d.email == request.auth.token.email
        && d.lastSeen == request.time;
    }

    // Profile: email + last visit (for the admin dashboard)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);
    }

    // Each user can only see and change their own records; admins can read all
    match /users/{userId}/entries/{entryId} {
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && entryId.matches('^[A-Za-z0-9_-]{1,64}$')
        && isValidEntry(request.resource.data);
    }

    // Collection-group queries over all users' entries (admin dashboard)
    match /{path=**}/entries/{entryId} {
      allow read: if isAdmin();
    }
  }
}
