rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidEntry(d) {
      return d.keys().hasAll(['name', 'amount', 'currency', 'kind', 'date'])
        && d.keys().hasOnly(['name', 'amount', 'currency', 'kind', 'date', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.amount is number && d.amount > 0
        && d.currency in ['PLN', 'USD', 'EUR', 'UAH', 'USDT']
        && d.kind in ['required', 'optional']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.updatedAt == request.time;
    }

    // Each user can only see and change their own records
    match /users/{userId}/entries/{entryId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidEntry(request.resource.data);
    }
  }
}
